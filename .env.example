# TERRANEXUS 4D ENVIRONMENT CONFIGURATION
# Copy this file to .env and configure your optional keys.
# Note: The platform operates with built-in scientific data even without API keys.

PORT=3001
VITE_API_URL=http://localhost:3001

# Optional: Google Gemini API Key for Nexus AI scientific explanations
# Get a key from https://aistudio.google.com/
GEMINI_API_KEY=

# Optional: Cesium Ion Token (CesiumJS works with open default OpenStreetMap / Sentinel tiles without this)
VITE_CESIUM_ION_TOKEN=
