# TERRANEXUS 4D ENVIRONMENT CONFIGURATION
# Copy this file to .env and configure your optional keys.
# Note: The platform operates with built-in scientific benchmark data even without API keys.

PORT=3001
VITE_API_URL=http://localhost:3001

# Optional: Google Gemini API Key for Nexus AI scientific explanations
# Get a key from https://aistudio.google.com/
GEMINI_API_KEY=

# Optional: Cesium Ion Token (CesiumJS works with open default OpenStreetMap / Sentinel tiles without this)
VITE_CESIUM_ION_TOKEN=

# =========================================================================
# NASA Earthdata Login Authentication (for genuine GRACE / GRACE-FO NetCDF downloads)
# =========================================================================
# NASA PO.DAAC requires a free user account before downloading raw satellite grid files.
# Account creation is 100% free with no paid tiers: https://urs.earthdata.nasa.gov/users/new
#
# Steps:
# 1. Register free at: https://urs.earthdata.nasa.gov/
# 2. Go to Applications -> Authorized Apps and ensure "PO.DAAC" is authorized.
# 3. Go to "Generate User Token" (or your Profile -> User Tokens) to generate a Bearer Token.
# 4. Paste your token below:
EARTHDATA_TOKEN=

# Alternatively, basic authentication credentials can be provided (used for URS redirect flows):
# EARTHDATA_USERNAME=your_username
# EARTHDATA_PASSWORD=your_password
