# ==============================================================================
# TERRANEXUS 4D — PUBLIC ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================
# SECURITY NOTICE:
# - THIS IS A PUBLIC TEMPLATE. NEVER COMMIT ACTUAL SECRETS OR TOKENS TO THIS FILE.
# - Copy this file to '.env' on your local computer:
#     copy .env.example .env     (Windows Command Prompt / PowerShell)
#     cp .env.example .env       (macOS / Linux)
# - Edit '.env' with your local values. '.env' is strictly ignored by Git.
# - The platform operates with built-in scientific benchmark data even without API keys.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION NETWORKING (Optional - Defaults Applied If Omitted)
# ------------------------------------------------------------------------------
# Port for the Express backend server (default: 3001)
PORT=3001

# Base URL that the React frontend uses to reach the Express backend (default: http://localhost:3001)
VITE_API_URL=http://localhost:3001

# ------------------------------------------------------------------------------
# 2. NEXUS AI COPILOT — GOOGLE GEMINI API (Optional)
# ------------------------------------------------------------------------------
# Google Gemini API key for live multimodal subsurface and hydrogeology explanations.
# If omitted or empty, TERRANEXUS 4D automatically falls back to its built-in
# local offline scientific rule-based explanation engine (no internet or key needed).
# Get a free API key at: https://aistudio.google.com/
GEMINI_API_KEY=

# ------------------------------------------------------------------------------
# 3. 3D GLOBE & GEOSPATIAL TERRAIN — CESIUM ION (Optional)
# ------------------------------------------------------------------------------
# Cesium Ion access token for high-resolution 3D World Terrain and satellite imagery.
# If omitted or empty, CesiumJS automatically falls back to open OpenStreetMap
# and Sentinel-2 cloudless basemaps without requiring an account or token.
# Get a free token at: https://cesium.com/ion/
VITE_CESIUM_ION_TOKEN=

# ------------------------------------------------------------------------------
# 4. NASA EARTHDATA / PO.DAAC SATELLITE ACQUISITION (Optional)
# ------------------------------------------------------------------------------
# Required ONLY when downloading genuine raw NASA GRACE/GRACE-FO Level-3 NetCDF files.
# If omitted or empty, the Nexus Hydro module uses verified local demonstration benchmarks
# (21 scientific fixtures across 7 Indian study loci).
#
# Account registration is 100% free with no paid tiers: https://urs.earthdata.nasa.gov/
# IMPORTANT: In your Earthdata profile (https://urs.earthdata.nasa.gov/profile):
#   1. Click 'Applications' -> 'Authorized Apps'.
#   2. Search for and authorize 'PO.DAAC Cloud' (or 'NASA PO.DAAC').
#   3. Click 'Generate Token' (or 'User Tokens') and copy the Bearer string below:
EARTHDATA_TOKEN=

# Alternative: Earthdata Login basic credentials (used for OAuth redirect flows)
# Optional fallback if you do not use a Bearer token:
# EARTHDATA_USERNAME=
# EARTHDATA_PASSWORD=

# ------------------------------------------------------------------------------
# 5. NASA PUBLIC SERVICE ENDPOINTS (Optional - Pre-configured Defaults)
# ------------------------------------------------------------------------------
# Official NASA Common Metadata Repository (CMR) public search endpoint
NASA_CMR_BASE_URL=https://cmr.earthdata.nasa.gov/search

# Official NASA Physical Oceanography Distributed Active Archive Center (PO.DAAC)
NASA_PO_DAAC_BASE_URL=https://archive.podaac.earthdata.nasa.gov

# ------------------------------------------------------------------------------
# 6. FUTURE EXTENSIBILITY PLACEHOLDERS (Optional)
# ------------------------------------------------------------------------------
# Placeholders for future third-party data providers or private enterprise geoservers
ADDITIONAL_API_KEY=
ADDITIONAL_PRIVATE_URL=
