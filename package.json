{
  "name": "terranexus-4d",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"cyan,magenta\" \"tsx watch server/index.ts\" \"vite\"",
    "dev:client": "vite",
    "dev:server": "tsx watch server/index.ts",
    "build": "tsc -b && vite build",
    "lint": "tsc --noEmit",
    "test": "tsx test/test-system.ts",
    "test:ingestion": "tsx test/test-ingestion.ts",
    "test:nasa": "tsx test/test-nasa-pipeline.ts",
    "test:phase4": "tsx test/test-phase4-suite.ts",
    "test:phase5": "tsx test/test-phase5-suite.ts",
    "test:all": "tsx test/test-system.ts && tsx test/test-ingestion.ts && tsx test/test-nasa-pipeline.ts && tsx test/test-api-routes.ts && tsx test/test-phase4-suite.ts && tsx test/test-phase5-suite.ts",
    "check:env": "tsx scripts/check-config.ts",
    "preview": "vite preview"
  },
  "dependencies": {
    "@google/genai": "^2.32.0",
    "@google/generative-ai": "^0.24.1",
    "cesium": "^1.121.0",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.13.3",
    "tailwind-merge": "^2.5.4",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.170.0",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "tsx": "^4.19.2",
    "typescript": "~5.6.3",
    "vite": "^5.4.11",
    "vite-plugin-cesium": "^1.2.23"
  }
}
