# ==============================================================================
# TERRANEXUS 4D — CRITICAL SECURITY & GITHUB PROTECTION RULES
# ==============================================================================

# 1. Environment & Secret Credentials (STRICT LOCAL ONLY - NEVER COMMIT)
.env
.env.*
!.env.example
*.local
*.local.*
*.pem
*.key
*.p12
*.pfx
credentials.json
secrets.json
service-account*.json
token.json
cookies.txt
*.sqlite
*.db
.netrc
_netrc
*.auth
*.session
*.token
*.credential
*.secret

# 2. Private Configuration Directory Protection
# Protects any private user configurations, notes, tokens, or custom credentials added to PRIVATE_CONFIG
PRIVATE_CONFIG/*
!PRIVATE_CONFIG/README.md
!PRIVATE_CONFIG/PRIVATE_SETTINGS.md
!PRIVATE_CONFIG/DATA_SOURCES.md
!PRIVATE_CONFIG/LOCAL_SETUP_GUIDE.md

# 3. Private Data, Downloads & Local Storage Dirs
private/
local-data/
downloads/
raw-private-data/

# 4. NASA Satellite Raw Data & Processed Binary Storage
# Preserves pristine directory isolation and prevents binary satellite files from entering Git
server/data/raw/*
!server/data/raw/.gitkeep
server/data/processed/*
!server/data/processed/.gitkeep
server/data/cache/*
!server/data/cache/hydro_locus-*.json
!server/data/cache/.gitkeep
server/data/demo/cgwb_wris_demo_click-*
server/data/demo/cgwb_wris_demo_loc-*
server/data/demo/cgwb_wris_demo_custom-pin-*
server/data/demo/cgwb_wris_demo_geo-*
server/data/demo/cgwb_wris_demo_osm-*
server/data/gis/*.geojsonl*
server/data/gis/*.7z
server/data/gis/*.zip

# 4b. Local Backups & Scratch Files
.backup*
backup*/
backups/
*.backup
*.bak
scratch/
scratch_*
temp_*
coverage/


# 5. Build Artifacts & Dependencies
node_modules/
dist/
dist-ssr/
*.tsbuildinfo

